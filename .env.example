# ===================================================================
# Variáveis de ambiente — Raízes do Nordeste Backend
# ===================================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA publique o arquivo .env no repositório.
# ===================================================================

# Chave secreta JWT (mínimo 32 caracteres, HMAC-SHA256)
APP_JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_SEGURA_DE_NO_MINIMO_32_CARACTERES

# Origens CORS permitidas (separadas por vírgula)
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Profile Spring ativo (dev, test ou prod)
SPRING_PROFILES_ACTIVE=dev
